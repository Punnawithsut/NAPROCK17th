diff --git a/CMakeLists.txt b/CMakeLists.txt
index a85e633..e9d1639 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -4,13 +4,19 @@ project(NAPROCK_Project LANGUAGES CXX)
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 
+if(APPLE)
+    set(OpenMP_CXX_FLAGS "-Xpreprocessor -fopenmp -I/opt/homebrew/opt/libomp/include")
+    set(OpenMP_CXX_LIB_NAMES omp)
+    set(OpenMP_omp_LIBRARY /opt/homebrew/opt/libomp/lib/libomp.dylib)
+endif()
+
 find_package(OpenMP REQUIRED)
 
 if(MSVC)
     add_compile_options(/Ox /fp:fast /Oi /Ot /GT /GL)
     add_link_options(/LTCG)
 else()
-    add_compile_options(-Ofast -march=native -flto)
+    add_compile_options(-O3 -march=native -flto)
 endif()
 
 find_package(cpr CONFIG REQUIRED)
@@ -24,4 +30,4 @@ target_link_libraries(app PRIVATE
     cpr::cpr 
     nlohmann_json::nlohmann_json
     OpenMP::OpenMP_CXX
-)
\ No newline at end of file
+)
